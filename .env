USER_AGENT="Happ"
PING_THRESHOLD_MS=250
MAX_KEYS_PER_GROUP=8
MAX_GROUPS_PER_COUNTRY=5
SOURCE_FILE="source"
OUTPUT_FILE="FREE-VPN-FROM-KIRILL.json"
TIMEOUT=15
MAX_WORKERS=10
CACHE_ENABLED=true
CACHE_TTL=3600
RETRY_COUNT=3
RETRY_DELAY=2

# Telegram
# TG_BOT_TOKEN="123456:ABC-DEF"
# TG_CHAT_ID="-1001234567890"
# TG_NOTIFY_ON_SUCCESS=true
# TG_NOTIFY_ON_ERROR=true

# Включить/выключить доп фичи
ENABLE_PING_CHECK=true
ENABLE_GEO_CHECK=true
ENABLE_DEDUP=true
ENABLE_RATING=true
ENABLE_LOGGING=true
ENABLE_CACHE=true
ENABLE_RETRY=true
